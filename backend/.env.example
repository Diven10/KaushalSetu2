# Copy this file to backend/.env and fill in your own values.
# Never commit the real .env — your password belongs in it, not in git.

# --- database ---
# Point this at the seeded skillgrow database.
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/skillgrow

# --- auth ---
JWT_SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- CORS ---
# Defaults already cover localhost:5173 / 5174 / 5175 (the three panels).
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- demo identity ---
# With this on, an unauthenticated call to a trainee/employer endpoint is
# answered as a demo account, so the panels open with real data and no login.
# Set to false to require a bearer token everywhere.
ALLOW_DEMO_IDENTITY=true
# DEMO_TRAINEE_ID=1
# DEMO_EMPLOYER_ID=1

# --- safety valve ---
# false = nothing is inserted or updated in Postgres; new postings,
# applications and status changes live in memory for the session only.
ALLOW_DB_WRITES=true

# --- ML layer ---
# false = /api/career-twin returns 503 instead of loading the ml package.
ENABLE_ML=true

# --- analytics ---
# Seconds to reuse the government portal's full-dataset rollup.
ANALYTICS_CACHE_TTL=300
