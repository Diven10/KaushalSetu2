# Where the KaushalSetu FastAPI backend is running.
VITE_API_BASE_URL=http://localhost:8000/api

# Set to true to force the built-in demonstration data instead of the backend.
VITE_USE_MOCK=false

# Set to true to make backend failures visible instead of silently falling
# back to demonstration data. Useful while wiring things up.
VITE_NO_FALLBACK=false

# Set to true to skip the login screen while developing a page.
# Never leave this on for a demo.
VITE_BYPASS_AUTH=false

# The shared sign-in page, served by the backend.
VITE_LOGIN_URL=http://localhost:8000/
